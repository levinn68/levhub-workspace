NODE_ENV=production
PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
ALLOWED_CORS_ORIGINS=http://localhost:3000
WORKSPACE_ID=00000000-0000-4000-8000-000000000001
WORKSPACE_NAME=LEVHUB Personal Workspace
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# Generate unique values; never commit real secrets.
APP_PASSWORD_HASH=
APP_SESSION_SECRET=replace-with-random-64-char-hex
APP_ENCRYPTION_KEY=replace-with-random-64-char-hex

# AI connection: Router only
ROUTER_BASE_URL=https://router.overdriveai.my.id/v1
ROUTER_API_KEY=
ROUTER_CATALOG_TTL_MS=60000
ROUTER_TIMEOUT_MS=45000

# Supabase backend only. Never expose service-role key to browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=levhub-skills

MAX_TOOL_CALLS_PER_TURN=6
TOOL_EXECUTION_TIMEOUT_MS=25000
MAX_TOOL_OUTPUT_BYTES=65536
MAX_SKILL_ARCHIVE_BYTES=10485760

LEVHUB_API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=LEVHUB
